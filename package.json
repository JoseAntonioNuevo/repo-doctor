{
  "name": "repo-doctor",
  "version": "0.2.0",
  "description": "Agent skill + standalone scripts to audit and slim bloated repositories — dead files, duplicate files, committed junk, and unused or duplicated dependencies, with an evidence-driven removal plan and post-cleanup verification.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Jose Antonio Nuevo",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoseAntonioNuevo/repo-doctor.git"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "repo-cleanup",
    "dead-code",
    "unused-dependencies",
    "duplicate-files",
    "dependency-audit",
    "monorepo"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "repo-doctor-scan": "bin/repo-doctor-scan.mjs",
    "repo-doctor-plan": "bin/repo-doctor-plan.mjs",
    "repo-doctor-verify": "bin/repo-doctor-verify.mjs"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "esbuild scan=scripts/scan-cli.ts plan=scripts/plan.ts verify=scripts/verify.ts --bundle --platform=node --format=esm --target=node22 --out-extension:.js=.mjs --outdir=bin --entry-names=repo-doctor-[name] --legal-comments=none",
    "check:generated": "pnpm build && git diff --exit-code -- bin",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:release": "pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
