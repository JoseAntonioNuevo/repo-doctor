#!/bin/sh
# Local GitHub Actions: always run Eve CI for this repo, then the
# agent-policy push guard. Never skip CI. Never drop the policy guard.
# Eve does not edit code.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$here/eve-ci" ]; then
  "$here/eve-ci"
else
  echo "pre-push: missing .githooks/eve-ci" >&2
  exit 1
fi

if [ -x "${HOME}/bin/agent-policy" ]; then
  exec "${HOME}/bin/agent-policy" guard "$@"
fi

exit 0
